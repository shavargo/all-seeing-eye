# Multi-stage Go build for GameSpy & Kingpin Master Server
FROM golang:alpine AS builder

WORKDIR /build
COPY go.mod ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /master ./cmd/master/main.go

FROM alpine:latest AS runtime
RUN apk --no-cache add ca-certificates tzdata \
    && addgroup -S master && adduser -S master -G master

USER master
COPY --from=builder /master /usr/local/bin/master

EXPOSE 27900/udp 27950/udp 28900/tcp 8085/tcp

ENV UDP_ADDR=":27900" \
    KPQ3_ADDR=":27950" \
    TCP_ADDR=":28900" \
    API_ADDR="0.0.0.0:8085" \
    ALLOW_PRIVATE="false"

ENTRYPOINT ["/usr/local/bin/master"]
